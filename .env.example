# Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Service Ports
AUTH_SERVICE_PORT=3001
SCHEDULE_SERVICE_PORT=3002

# Service Database URLs
AUTH_DATABASE_URL=postgresql://postgres:your_postgres_password@postgres:5432/auth_db?schema=public
SCHEDULE_DATABASE_URL=postgresql://postgres:your_postgres_password@postgres:5432/schedule_db?schema=public

# JWT Authentication Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d

# Inter-service Communication
AUTH_SERVICE_URL=http://auth-service:3001
